# ==============================================================================
# Cybersecurity Learning Tracker — Environment Configuration (.env.example)
# Copy to .env.local for local development. Configure in Vercel Project Settings
# for production deployment. NEVER commit real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STORAGE (Firestore Admin SDK is for data storage only)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Escape newlines as \n when pasting into .env.local or Vercel
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional explicit storage selector: "firestore" (recommended on Vercel) or "postgres"
# STORAGE_BACKEND=firestore

# ------------------------------------------------------------------------------
# 2. PASSWORD AUTHENTICATION (Server-Only)
# ------------------------------------------------------------------------------
# Store only a scrypt hash here, never a plaintext password. The application
# never sends this value to the browser.
# Escape every $ as \$ (e.g. scrypt\$16384\$8\$1\$<salt>\$<hash>) or Next.js
# will expand it as a variable and break login.
APP_PASSWORD_HASH=
APP_SESSION_SECRET=

# Generate a scrypt hash with the command in README.md. Generate the session
# signing key using: openssl rand -hex 32

# Legacy SHA-256 migration compatibility (DISABLED by default — enable ONLY
# temporarily while migrating an old sha256$<hex> hash to scrypt$):
# ALLOW_LEGACY_SHA256_HASH=false
